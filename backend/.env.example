DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/moigo_dev
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

TOSS_CLIENT_ID=c_xxxxxxxxxxxxxxxxxxxxxxxxxxx
TOSS_CLIENT_SECRET=s_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 뉴스 검색 (NCP API HUB)
NAVER_CLIENT_ID=xxxxxxxxxx
NAVER_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-adminsdk.json

# AI 추천 (키가 없는 모델은 추천을 만들지 않고 화면에서도 숨긴다)
CLOVA_API_KEY=nv-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOVA_MODEL=HCX-005
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5-5
# 평일 이 시각(KST) 이후 하루 한 번 추천 생성. 여러 명이 같은 DB를 쓰면 한 명만 True로 둔다
AI_SCHEDULER_ENABLED=true
AI_RECOMMEND_HOUR=16
