# 실제 값은 .env 파일에 넣고 .env는 절대 커밋하지 마세요.

# 네이버 개발자센터 > 애플리케이션 > 사용 API에서 발급
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# 토스증권 Open API (OAuth2 Client Credentials, https://openapi.tossinvest.com)
TOSS_CLIENT_ID=c_xxxxxxxxxxxxxxxxxxxxxxxxxxx
TOSS_CLIENT_SECRET=s_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
